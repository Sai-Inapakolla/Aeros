# ==============================================================================
# AEROS PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# MongoDB Atlas / CQRS Read Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/
MONGODB_FLIGHT_URI=mongodb+srv://<username>:<password>@<cluster-address>/flight_read?retryWrites=true&w=majority
MONGODB_PASSENGER_URI=mongodb+srv://<username>:<password>@<cluster-address>/passenger_read?retryWrites=true&w=majority
MONGODB_BOOKING_URI=mongodb+srv://<username>:<password>@<cluster-address>/booking_read?retryWrites=true&w=majority

MONGODB_FLIGHT_DB=flight_read
MONGODB_PASSENGER_DB=passenger_read
MONGODB_BOOKING_DB=booking_read

# PostgreSQL Database (Write Side)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aeros
POSTGRES_USER=aeros
POSTGRES_PASSWORD=aeros

# RabbitMQ Message Broker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Keycloak IAM (OAuth2 / OpenID Connect)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=keycloak-realm
KEYCLOAK_CLIENT_ID=booking-client-credentials
KEYCLOAK_CLIENT_SECRET=secret
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/keycloak-realm/protocol/openid-connect/certs

# Microservices Ports
GATEWAY_PORT=8081
FLIGHT_SERVICE_PORT=8082
PASSENGER_SERVICE_PORT=8083
BOOKING_SERVICE_PORT=8084
FRONTEND_PORT=4200

GATEWAY_URL=http://localhost:8081
FLIGHT_SERVICE_URL=http://localhost:8082
PASSENGER_SERVICE_URL=http://localhost:8083
BOOKING_SERVICE_URL=http://localhost:8084

# gRPC Internal Service Ports
FLIGHT_GRPC_PORT=9092
PASSENGER_GRPC_PORT=9093
BOOKING_GRPC_PORT=9094

# Observability (OpenTelemetry)
OTEL_COLLECTOR_ENDPOINT=http://localhost:4317
